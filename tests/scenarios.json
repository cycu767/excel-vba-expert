{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "S01",
      "prompt": "Copy values between two explicitly provided workbooks without active-context mistakes.",
      "route": "develop",
      "required_resources": [
        "references/excel-object-model.md",
        "references/workbook-worksheet-range.md"
      ],
      "must_demonstrate": [
        "explicit source and target ownership",
        "ThisWorkbook is not automatically the destination",
        "dimensions validated",
        "restore original application state"
      ],
      "must_not_do": [
        "bare Range/Cells against active workbook",
        "production overwrite without permission"
      ],
      "execution_status": "NOT_RUN_WITH_LIVE_AGENT",
      "automated_check_scope": "route/resource/static contract only"
    },
    {
      "id": "S02",
      "prompt": "Diagnose a Worksheet_Change loop caused by a multi-cell paste.",
      "route": "debug",
      "required_resources": [
        "references/events.md",
        "references/debugging.md"
      ],
      "must_demonstrate": [
        "Target may contain multiple cells",
        "Intersect uses the intended sheet",
        "re-entry protection",
        "original reproduction and regression"
      ],
      "must_not_do": [
        "assume Target.Value is scalar",
        "broad On Error Resume Next"
      ],
      "execution_status": "NOT_RUN_WITH_LIVE_AGENT",
      "automated_check_scope": "route/resource/static contract only"
    },
    {
      "id": "S03",
      "prompt": "Implement a temporary EnableEvents guard when events may already be disabled.",
      "route": "develop",
      "required_resources": [
        "references/errors-recovery.md",
        "references/events.md"
      ],
      "must_demonstrate": [
        "capture before mutation",
        "restore exact original False or True",
        "preserve primary error",
        "report cleanup failure"
      ],
      "must_not_do": [
        "unconditional EnableEvents=True",
        "End bypassing cleanup"
      ],
      "execution_status": "NOT_RUN_WITH_LIVE_AGENT",
      "automated_check_scope": "route/resource/static contract only"
    },
    {
      "id": "S04",
      "prompt": "Audit an MSForms form with dynamic buttons and many event handlers.",
      "route": "userform",
      "required_resources": [
        "references/userforms-msforms.md",
        "references/ui-ux-userforms.md"
      ],
      "must_demonstrate": [
        "retain handler instances",
        "check frm/frx pair",
        "Initialize vs Activate",
        "keyboard and close-mode test plan"
      ],
      "must_not_do": [
        "HTML/CSS as native Forms properties",
        "claim UI tests from source inspection"
      ],
      "execution_status": "NOT_RUN_WITH_LIVE_AGENT",
      "automated_check_scope": "route/resource/static contract only"
    },
    {
      "id": "S05",
      "prompt": "Review GetActiveWindow and Sleep declarations for 64-bit Office.",
      "route": "api64",
      "required_resources": [
        "references/windows-api-vba7.md"
      ],
      "must_demonstrate": [
        "PtrSafe separate from pointer types",
        "HWND LongPtr",
        "DWORD Long",
        "VBA7 conditional compilation"
      ],
      "must_not_do": [
        "replace every Long with LongPtr",
        "claim both Office bitnesses compiled"
      ],
      "execution_status": "NOT_RUN_WITH_LIVE_AGENT",
      "automated_check_scope": "route/resource/static contract only"
    },
    {
      "id": "S06",
      "prompt": "Diagnose an Excel process remaining after Python COM automation.",
      "route": "com",
      "required_resources": [
        "references/excel-com-automation.md"
      ],
      "must_demonstrate": [
        "owned vs attached process",
        "child references and modal dialogs",
        "Quit attempted after Close failure",
        "primary vs cleanup exceptions"
      ],
      "must_not_do": [
        "taskkill all Excel processes",
        "treat mocked cleanup as real COM evidence"
      ],
      "execution_status": "NOT_RUN_WITH_LIVE_AGENT",
      "automated_check_scope": "route/resource/static contract only"
    },
    {
      "id": "S07",
      "prompt": "Create an updateable named Excel chart without deleting other charts.",
      "route": "chart",
      "required_resources": [
        "references/charts-visualization.md"
      ],
      "must_demonstrate": [
        "ChartObject vs Chart",
        "explicit source and intended sheet",
        "stable chart identity",
        "empty data and repeat test"
      ],
      "must_not_do": [
        "confuse Graph REST with Excel charts",
        "blanket chart deletion"
      ],
      "execution_status": "NOT_RUN_WITH_LIVE_AGENT",
      "automated_check_scope": "route/resource/static contract only"
    },
    {
      "id": "S08",
      "prompt": "Audit a legacy VBA module with apparently unused entry points.",
      "route": "refactor",
      "required_resources": [
        "references/refactoring-legacy.md"
      ],
      "must_demonstrate": [
        "characterization baseline",
        "Application.Run/OnAction/events/external callers",
        "confidence levels",
        "small reversible patches"
      ],
      "must_not_do": [
        "delete based on zero text references",
        "silently change business rounding"
      ],
      "execution_status": "NOT_RUN_WITH_LIVE_AGENT",
      "automated_check_scope": "route/resource/static contract only"
    },
    {
      "id": "S09",
      "prompt": "Find the official documentation for Excel.Range.Find.",
      "route": "lookup",
      "required_resources": [
        "references/documentation-index.md"
      ],
      "must_demonstrate": [
        "exact local lookup",
        "MS-FIND",
        "persistent options and Nothing",
        "official source URL"
      ],
      "must_not_do": [
        "invent missing signature details"
      ],
      "execution_status": "NOT_RUN_WITH_LIVE_AGENT",
      "automated_check_scope": "route/resource/static contract only"
    },
    {
      "id": "S10",
      "prompt": "A request mentions Range.SetFancyGradient. Determine whether it exists.",
      "route": "lookup",
      "required_resources": [
        "references/documentation-index.md",
        "references/excel-object-model.md"
      ],
      "must_demonstrate": [
        "index miss is not proof",
        "verify owning object and source or Object Browser",
        "no invented method",
        "mark unresolved offline"
      ],
      "must_not_do": [
        "assert nonexistence from incomplete index",
        "generate plausible API call"
      ],
      "execution_status": "NOT_RUN_WITH_LIVE_AGENT",
      "automated_check_scope": "route/resource/static contract only"
    }
  ]
}
